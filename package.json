{
  "name": "file-finder",
  "version": "1.0.0",
  "description": "Scan the drive for documents (doc, docx, xls, xlsx, pdf), search them and open them.",
  "main": "main.js",
  "homepage": "https://example.com/file-finder",
  "author": "File Finder <noreply@example.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.example.filefinder",
    "productName": "File Finder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "scanner-worker.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "File Finder <noreply@example.com>"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0"
  }
}
